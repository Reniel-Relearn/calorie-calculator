{
  "name": "caloriecheck",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:auth:local": "node tests/integration/auth-local.mjs",
    "test:db": "supabase test db",
    "security:scan": "node scripts/security-scan.mjs",
    "check:security": "npm audit --audit-level=high && npm run security:scan",
    "check": "npm run test && npm run build && npm run check:security",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:db:reset": "supabase db reset",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "supabase": "2.121.0",
    "vite": "8.3.4"
  }
}
