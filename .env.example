# CalorieCheck public browser configuration
#
# Copy this file to .env.local for local development. Vite embeds every
# VITE_* value in the browser bundle, so these variables must never contain a
# Supabase secret key, legacy service_role key, database password, SMTP
# credential, Vercel token, or any other privileged value.

# Use local, staging, or production.
VITE_APP_ENV=local

# Local values are printed by `npm run supabase:start`.
# Hosted staging values come from the Supabase project's Connect dialog.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROVIDER_VALUE
